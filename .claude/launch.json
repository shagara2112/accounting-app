{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lajur",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "set -a && source .env && exec ./bin/lajur serve"
      ],
      "port": 8080
    },
    {
      "name": "lajur-verify",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "set -a && source .env && LAJUR_LISTEN=:8081 exec ./bin/lajur serve"
      ],
      "port": 8081
    }
  ]
}
