# Salin ke .env untuk pengembangan lokal: cp .env.example .env
# Nilai di sini hanya untuk laptop pengembang, bukan untuk server pelanggan.

LAJUR_LISTEN=:8080
LAJUR_DATABASE_URL=postgres://lajur:lajur-dev@127.0.0.1:5433/lajur?sslmode=disable

# Basis data admin untuk tes integrasi; tes membuat dan menghapus basis data sementara sendiri.
LAJUR_TEST_DATABASE_URL=postgres://lajur:lajur-dev@127.0.0.1:5433/postgres?sslmode=disable

# Laptop tanpa klien PostgreSQL: pg_dump/pg_restore dijalankan di container basis data dev.
LAJUR_PG_DOCKER=lajur-dev-db-1
LAJUR_TEST_PG_DOCKER=lajur-dev-db-1

# Folder data (backup dan lampiran) di laptop; di server pelanggan /var/lib/lajur.
LAJUR_DATA_DIR=./.data

# Kunci publik backup. Buat dengan `go run ./cmd/lajur backup-keygen`; simpan kunci privatnya
# sendiri (mis. .data/backup-dev-private.key) untuk mencoba `lajur restore`.
LAJUR_BACKUP_PUBLIC_KEY=

# Lisensi tiruan untuk pengembangan. Coba ganti ke EXPIRED atau SUSPENDED untuk melihat perilakunya.
LAJUR_LICENSE_MODE=local
LAJUR_LICENSE_LOCAL_STATUS=ACTIVE
LAJUR_LICENSE_LOCAL_EXPIRES=2027-12-31

# Server pengembangan berjalan di HTTP biasa.
LAJUR_SECURE_COOKIES=false

# Kunci enkripsi kolom sensitif (rahasia 2FA, license key). Di server pelanggan dibuat
# acak oleh skrip instal; nilai ini hanya untuk laptop pengembang.
LAJUR_APP_KEY=bGFqdXItZGV2LWtleS1oYW55YS11bnR1ay1sYXB0b3A=

# 2FA wajib untuk Pemilik, Manager, dan Admin pelanggan. Dimatikan di laptop supaya
# akun contoh bisa langsung masuk; jangan dimatikan di server pelanggan.
LAJUR_MFA_REQUIRED=false

# Kata sandi semua akun contoh dari `make seed`.
LAJUR_DEV_SEED_PASSWORD=lajur-dev-2026
